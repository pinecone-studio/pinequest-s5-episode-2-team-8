{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "headers": [
    { "source": "/Build/(.*)\\.wasm\\.gz", "headers": [{ "key": "Content-Encoding", "value": "gzip" }, { "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "/Build/(.*)\\.js\\.gz", "headers": [{ "key": "Content-Encoding", "value": "gzip" }, { "key": "Content-Type", "value": "application/javascript" }] },
    { "source": "/Build/(.*)\\.data\\.gz", "headers": [{ "key": "Content-Encoding", "value": "gzip" }, { "key": "Content-Type", "value": "application/octet-stream" }] },
    { "source": "/Build/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
