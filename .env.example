# Басар AI нохойг идэвхжүүлэх: энэ файлыг ".env" нэртэй хуулаад түлхүүрээ бичнэ.
# Түлхүүргүй үед Басар офлайн мэдлэгээрээ ажиллана.
ANTHROPIC_API_KEY=
# BASAR_MODEL=claude-opus-5-5
# BASAR_DAILY_LIMIT=1500
# Optional PostgreSQL room storage. Keep this credential private.
# For Supabase use the SESSION POOLER connection string on port 5432 (pooler host). Do NOT use the transaction pooler (port 6543) because LISTEN/NOTIFY does not work through it; the direct connection is often IPv6-only and may not work on Render.
# Leave empty to save rooms in data/ (no database needed). Example:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Weekly parent email (Resend, https://resend.com). Read from the server's environment (Render: Environment tab), not
# from this file. Without both RESEND_API_KEY and EMAIL_FROM the feature is off. EMAIL_FROM must be on a domain
# verified in Resend, e.g. Naadamy <hello@your-domain>.
# PUBLIC_URL is where the confirm/stop links point (default: the Render URL).
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_URL=
# Optional: memory book voice clips in a PRIVATE Supabase Storage bucket (the server is the only one with the key).
# Supabase → Project Settings → API Keys: the service_role (secret) key. Never give it to the game or a browser.
# Leave SUPABASE_URL empty to keep the clips in data/voice/ instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_VOICE_BUCKET=naadamy-voice
# VOICE_MAX_CLIPS=200
# VOICE_MAX_MB=500
# VOICE_MAX_TOTAL_MB=900
# Without Supabase, uploads are off on Render or with DATABASE_URL set; VOICE_ON_DISK=true keeps them in DATA_DIR/voice anyway:
# one server only (the files live on its disk), and on Render set VOICE_MAX_TOTAL_MB well under the disk size (e.g. 300).
# VOICE_ON_DISK=
